# WireGuard Easy version to build
# Can be a tag (e.g., v15.1.0) or a commit hash
WG_EASY_TAG=v15.1.0

# General settings
# Set your timezone (e.g., America/New_York, Europe/London, Asia/Tokyo, UTC)
TIMEZONE=UTC

# User and group identifiers
# User ID
PUID=1000
# Group ID
PGID=1000

# Network settings
# Static IP for DNS Server
UNBOUND_IPV4_ADDRESS=10.2.0.200
# Static IP for Pi-hole
PIHOLE_IPV4_ADDRESS=10.2.0.100

# Wireguard settings
TZ=UTC
SERVERPORT=51820
WGUI_PORT=51821
# WireGuard host (public IP or domain) - leave empty for auto-detection
WG_HOST=
# WireGuard default DNS for clients (Pi-hole for ad-blocking)
WG_DEFAULT_DNS=10.2.0.100
# WireGuard allowed IPs (what clients can access through VPN)
# Use 10.2.0.0/24 for split-tunnel (only VPN network)
# Use 0.0.0.0/0 for full-tunnel (all traffic through VPN)
WG_ALLOWED_IPS=10.2.0.0/24
# WireGuard persistent keepalive (optional, seconds, 0=disabled)
WG_PERSISTENT_KEEPALIVE=0
# WireGuard MTU (optional, leave empty for auto)
WG_MTU=
# Enable experimental AWG features
EXPERIMENTAL_AWG=true

# Pi-hole settings
# CHANGE THIS PASSWORD!
WEBPASSWORD=admin
# IP address for the DNS server used by Pi-hole
PIHOLE_DNS=10.2.0.200
ServerIP=10.2.0.100 # Internal IP of pihole
DNS1=10.2.0.200 # DNS Server IP
DNS2=10.2.0.200 # If we don't specify two, it will auto pick google.

# DNS Server (Technitium) settings
# CHANGE THIS PASSWORD!
DNS_SERVER_ADMIN_PASSWORD=admin
