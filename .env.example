# WireGuard Easy version to build
# Can be a tag (e.g., v15.1.0) or a commit hash
WG_EASY_TAG=v15.1.0

# General settings
# Set your timezone (e.g., America/New_York, Europe/London, Asia/Tokyo, UTC)
TIMEZONE=UTC
TZ=UTC

# User and group identifiers
PUID=1000
PGID=1000

# Network settings (static container IPs on the 10.2.0.0/24 bridge)
UNBOUND_IPV4_ADDRESS=10.2.0.200
PIHOLE_IPV4_ADDRESS=10.2.0.100

# ─── WireGuard / wg-easy ────────────────────────────────────────────────
# Public UDP port. Used both as the host-side port AND as the in-container
# WireGuard listener (via INIT_PORT). Must be reachable from the internet.
SERVERPORT=51820

# Admin web UI port. Bound to 127.0.0.1 only — access via SSH tunnel:
#   ssh -L 51821:127.0.0.1:51821 user@your-host
WGUI_PORT=51821

# ── First-boot setup (wg-easy v15 unattended setup) ─────────────────────
# These are applied ONLY on the first start when ./config is empty.
# After that, change settings via the web UI. Re-seeding requires
# deleting the SQLite DB in ./config (destroys all clients/keys).
# Docs: https://wg-easy.github.io/wg-easy/latest/advanced/config/unattended-setup/

# Enable unattended first-boot setup. Set to "false" to use the web UI wizard.
INIT_ENABLED=true

# Admin credentials. CHANGE THESE before first boot.
INIT_USERNAME=admin
INIT_PASSWORD=ChangeMe!ChangeMe!

# Public hostname or IP that VPN clients will use as Endpoint.
# Required (cannot be empty). Examples: vpn.example.com, 203.0.113.10
INIT_HOST=

# Default DNS handed to VPN clients (Pi-hole for ad-blocking).
# Comma-separated for multiple servers.
INIT_DNS=10.2.0.100

# AllowedIPs in generated client configs.
#   10.2.0.0/24 → split-tunnel (only VPN network goes through tunnel)
#   0.0.0.0/0,::/0 → full-tunnel (all traffic through VPN)
INIT_ALLOWED_IPS=10.2.0.0/24

# WireGuard subnet given to peers (clients live inside these CIDRs).
INIT_IPV4_CIDR=10.8.0.0/24
INIT_IPV6_CIDR=fdcc:ad94:bacf:61a4::cafe:0/112

# Enable experimental AmneziaWG support. Auto-detects the kernel module.
EXPERIMENTAL_AWG=true
# AmneziaWG kernel module ref to build (master = follow upstream).
# Pin to a SHA for reproducibility, e.g. AWG_KERNEL_REF=ac946a9
AWG_KERNEL_REF=master

# ─── Pi-hole ────────────────────────────────────────────────────────────
# CHANGE THIS PASSWORD!
WEBPASSWORD=admin
PIHOLE_DNS=10.2.0.200
ServerIP=10.2.0.100
DNS1=10.2.0.200
DNS2=10.2.0.200

# ─── Technitium DNS Server ──────────────────────────────────────────────
# CHANGE THIS PASSWORD!
DNS_SERVER_ADMIN_PASSWORD=admin
